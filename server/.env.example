# Copy from ../.env.example when deploying server separately.
NODE_ENV=development
SERVER_PORT=2345
MONGO_URI=mongodb://127.0.0.1:27017/make-my-yatra
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
SENTRY_DSN=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000
OTP_SECRET=replace-with-a-long-random-otp-secret
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_LOCK_MINUTES=15
COOKIE_SECRET=replace-with-a-long-random-cookie-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_MAX=60
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
JOBS_ENABLED=false
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Make My Yatra
SMTP_HOST=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tirthyatra.local
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
PAYMENT_CURRENCY=INR
DEFAULT_BOOKING_AMOUNT=5305

# Live Google Flights style search. Keep this key only on the backend.
# GOOGLE_FLIGHT_API_PROVIDER can be auto, flightsapi, or serpapi.
GOOGLE_FLIGHT_API_PROVIDER=auto
GOOGLE_FLIGHT_API_KEY=
